@using System.Net.Http.Json
@inject HttpClient HttpClient

@code {
    [Parameter]
    public string CityCode { get; set; } = "GUA";
}

<style>
    .forecast-scroll-outer {
        overflow-x: auto;
        margin-bottom: 16px;
        scrollbar-width: thin;
    }
    .forecast-strip-wrapper {
        display: flex;
        width: max-content;
    }
    .forecast-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 10px 14px 8px;
        width: 80px !important;
        flex: 0 0 80px !important;
        min-width: 0;
        border-right: 1px solid #dde6e8;
        gap: 5px;
        cursor: default;
        position: relative;
        box-sizing: border-box;
    }
    .forecast-card:last-child { border-right: none; }
    .forecast-card--now { background: linear-gradient(to bottom, #FDB949, #ffe1c3) !important; }
    .forecast-card__label { font-size: 0.46rem; font-weight: 700; color: #b8692a; letter-spacing: 0; text-transform: uppercase; line-height: 1.1; text-align: center; width: 100%; white-space: nowrap; overflow: visible; }
    .forecast-card__time { font-size: 0.72rem; font-weight: 600; color: #1e5f6e; line-height: 1; }
    .forecast-card__icon { width: 26px; height: 26px; object-fit: contain; }
    .forecast-card__temp { font-size: 1.25rem; font-weight: 400; color: #1e5f6e; line-height: 1; }
    .forecast-card__precip { font-size: 0.62rem; color: #1e7ca0; min-height: 13px; line-height: 1; }
</style>



<div class="current-weather" style="background-image: linear-gradient(to bottom, #e6f7ee, #f5f8f6); margin: 0 auto; padding: 20px; border-radius: 10px; border: 1px solid #a8a8a8; font-family: inherit; font-size: 0.95rem;">

@if (isLoading)
{
    <div>Cargando pronóstico...</div>
}
else if (forecastData != null && forecastData.Count > 0)
{
    <div class="forecast-scroll-outer">
    <div class="forecast-strip-wrapper">
        @{ var ordered = forecastData.OrderBy(f => f.EffectiveDate).ToList(); }
        @for (int i = 0; i < ordered.Count; i++)
        {
            var item = ordered[i];
            bool isNow = i == 0;
            <div class="forecast-card @(isNow ? "forecast-card--now" : "")" data-bs-toggle="tooltip" data-bs-placement="top" title="@item.IconPhrase">
                @if (isNow)
                {
                    <span class="forecast-card__label">PRÓXIMAMENTE</span>
                }
                <span class="forecast-card__time">@item.EffectiveDate.ToString("HH:mm")</span>
                <img class="forecast-card__icon" src="/images/icons/@GetForecastIcon(item.IconPhrase)" alt="@item.IconPhrase" />
                <span class="forecast-card__temp">@((int)(item.Temperature ?? 0))°</span>
                <span class="forecast-card__precip">
                    @if (item.TotalLiquid.HasValue && item.TotalLiquid > 0)
                    {
                        @($"{item.TotalLiquid.Value:F1} mm")
                    }
                    else
                    {
                        <text>–</text>
                    }
                </span>
            </div>
        }
    </div>
    </div>
    <div style="width: 100%; max-width: 680px; aspect-ratio: 2 / 1; position: relative;">
        <canvas id="precipChart" style="width: 100% ; height: 100% ;"></canvas>
    </div>

}
else
{
    <div>No hay datos de pronóstico.</div>
}

</div>


@code {
    private List<WeatherForecast> forecastData = new();
    private bool isLoading = true;
    private bool chartNeedsRender = false;
    private string? _lastCityCode;

    protected override async Task OnParametersSetAsync()
    {
        if (CityCode == _lastCityCode) return;
        _lastCityCode = CityCode;
        await LoadForecastData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartNeedsRender && forecastData != null && forecastData.Count > 0)
        {
            await DrawChart();
            if (JS != null)
                await JS.InvokeVoidAsync("initTooltips");
            chartNeedsRender = false;
        }
    }

    private class WeatherForecastResponse
    {
        public List<WeatherForecast>? Value { get; set; }
    }

    private async Task LoadForecastData()
    {
        isLoading = true;
        try
        {
            var response = await HttpClient.GetFromJsonAsync<WeatherForecastResponse>($"/rest/GetWeatherForecast?CityCode={CityCode}");
            forecastData = response?.Value ?? new List<WeatherForecast>();
        }
        catch { forecastData = new(); }
        isLoading = false;
        chartNeedsRender = forecastData != null && forecastData.Count > 0;
    }

    private async Task DrawChart()
    {
        if (forecastData == null || forecastData.Count == 0)
            return;
        var labels = forecastData.Select(f => f.EffectiveDate.ToString("HH:mm")).ToArray();
        var precipitation = forecastData.Select(f => f.TotalLiquid ?? 0).ToArray();
        var temperatures = forecastData.Select(f => f.Temperature ?? 0).ToArray();
        var realFeelTemps = forecastData.Select(f => f.RealFeelTemperature ?? 0).ToArray();
        if (JS != null)
            await JS.InvokeVoidAsync("drawForecastChart", labels, precipitation, temperatures, realFeelTemps);
    }

    [Inject] IJSRuntime? JS { get; set; }

    private static string GetForecastIcon(string? phrase)
    {
        if (string.IsNullOrEmpty(phrase)) return "clouds.png";
        var p = phrase.ToLowerInvariant();
        if (p.Contains("tormenta") && (p.Contains("lluvia") || p.Contains("llovizna"))) return "rainthunderlow.png";
        if (p.Contains("tormenta") && p.Contains("fuerte")) return "lightning.png";
        if (p.Contains("tormenta")) return "thunder.png";
        if (p.Contains("lluvia intensa") || p.Contains("lluvia fuerte") || p.Contains("muy lluvioso")) return "rainheavy.png";
        if (p.Contains("lluvia moderada") || p.Contains("moderadamente lluvioso")) return "rainmoderate.png";
        if (p.Contains("chubascos") || p.Contains("llovizna") || p.Contains("lluvia ligera")) return "rainlow.png";
        if (p.Contains("lluvia") || p.Contains("lluvioso")) return "rain.png";
        if (p.Contains("niebla") || p.Contains("neblina") || p.Contains("bruma")) return "fog.png";
        if (p.Contains("viento") && (p.Contains("noche") || p.Contains("nocturno"))) return "windnight.png";
        if (p.Contains("viento") && (p.Contains("nublado") || p.Contains("nubes"))) return "windcloudy.png";
        if (p.Contains("viento") && (p.Contains("sol") || p.Contains("despejado"))) return "windsun.png";
        if (p.Contains("viento")) return "wind.png";
        if (p.Contains("noche") || p.Contains("nocturno")) return "starrynight.png";
        if (p.Contains("mayormente nublado") || p.Contains("muy nublado") || p.Contains("nublado")) return "clouds.png";
        if (p.Contains("parcialmente nublado") || p.Contains("algo nublado") || p.Contains("intervalos nubosos")) return "cloudy2.png";
        if (p.Contains("mayormente despejado") || p.Contains("mayormente soleado") || p.Contains("algunas nubes")) return "cloudy1.png";
        if (p.Contains("soleado") || p.Contains("despejado") || p.Contains("sol")) return "sunny.png";
        return "clouds.png";
    }

    public class WeatherForecast
    {
        public DateTime ForecastDate { get; set; }
        public DateTime EffectiveDate { get; set; }
        public string? Phrase { get; set; }
        public string? IconPhrase { get; set; }
        public double? TotalLiquid { get; set; }
        public double? Temperature { get; set; }           // Updated for hourly API
        public double? RealFeelTemperature { get; set; }   // Updated for hourly API
        public int? PrecipitationProbability { get; set; }
        public string? PrecipitationIntensity { get; set; }
    }
}
